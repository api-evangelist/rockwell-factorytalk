          "name": "Get Historical Trend Data",
          "request": {
            "name": "Get Historical Trend Data",
            "description": {
              "content": "Returns historical trending data for a tag within a time range.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "trends",
                ":tagName"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "startTime",
                  "value": "<dateTime>",
                  "description": "(Required) "
                },
                {
                  "disabled": false,
                  "key": "endTime",
                  "value": "<dateTime>",
                  "description": "(Required) "
                },
                {
                  "disabled": false,
                  "key": "resolution",
                  "value": "1m",
                  "description": "Data resolution (e.g., 1s, 1m, 1h)"
                },
                {
                  "disabled": false,
                  "key": "limit",
                  "value": "1000"
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "tagName",
                  "description": "(Required) Tag name (may use dot notation for nested tags, e.g. Conveyor1.Speed)"
                },
                {
                  "description": "FactoryTalk Optix server hostname",
                  "type": "any",
                  "value": "{{host}}",
                  "key": "host"
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
