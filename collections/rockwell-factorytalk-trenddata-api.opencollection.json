{
  "opencollection": "1.0.0",
  "info": {
    "name": "Rockwell FactoryTalk Optix REST Alarms TrendData API",
    "version": "1.5.0"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "client_credentials",
      "accessTokenUrl": "https://optix.example.com/auth/token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "TrendData",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get Historical Trend Data",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{host}/api/v1/trends/:tagName",
            "params": [
              {
                "name": "tagName",
                "value": "",
                "type": "path",
                "description": "Tag name (may use dot notation for nested tags, e.g. Conveyor1.Speed)"
              },
              {
                "name": "startTime",
                "value": "",
                "type": "query"
              },
              {
                "name": "endTime",
                "value": "",
                "type": "query"
              },
              {
                "name": "resolution",
                "value": "",
                "type": "query",
                "description": "Data resolution (e.g., 1s, 1m, 1h)"
              },
              {
                "name": "limit",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Returns historical trending data for a tag within a time range."
        }
      ]
    }
  ],
  "bundled": true
}